 "steps": [
  {
   "id": "deployer",
   "label": "Déployer",
   "title": "Déployer : mettre une nouvelle version en service",
   "body": [
    "Une ligne de code corrigée n'aide personne tant qu'elle n'est pas en service."
   ],
   "show": [
    "d-src",
    "d-srv",
    "d-run"
   ],
   "links": [],
   "hud": [
    {
     "label": "en service",
     "value": "v1"
    }
   ],
   "script": [
    {
     "do": "wait",
     "ms": 900
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "d-src",
       "label": "frais de port corrigés"
      }
     ],
     "say": "Un développeur corrige le calcul des frais de port dans le **code source**."
    },
    {
     "do": "wait",
     "ms": 700
    },
    {
     "do": "scene",
     "show": [
      "d-build"
     ],
     "link": [
      {
       "from": "d-src",
       "to": "d-build"
      }
     ],
     "say": "La **construction** compile, empaquette et passe les tests."
    },
    {
     "do": "send",
     "path": [
      "d-src",
      "d-build"
     ],
     "label": "v2"
    },
    {
     "do": "scene",
     "show": [
      "d-art"
     ],
     "link": [
      {
       "from": "d-build",
       "to": "d-art"
      }
     ],
     "say": "Elle produit un **artefact** : le paquet prêt à lancer."
    },
    {
     "do": "send",
     "path": [
      "d-build",
      "d-art"
     ],
     "label": "v2"
    },
    {
     "do": "scene",
     "link": [
      {
       "from": "d-art",
       "to": "d-run"
      }
     ],
     "say": "**Déployer**, c'est installer cet artefact et le mettre en service à la place de l'ancien."
    },
    {
     "do": "send",
     "path": [
      "d-art",
      "d-run"
     ],
     "label": "v2"
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "d-run",
       "title": "v2 en service",
       "tone": "y"
      }
     ],
     "hud": [
      {
       "label": "en service",
       "value": "v2"
      }
     ],
     "say": "Ce qu'on livre d'un bloc s'appelle une **unité de déploiement**."
    },
    {
     "do": "wait",
     "ms": 3000
    }
   ]
  },
